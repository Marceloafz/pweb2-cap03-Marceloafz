<section class="page-heading">
  <div>
    <p class="eyebrow">Operação</p>
    <h1>Entregas</h1>
    <p class="muted">Acompanhe e gerencie suas entregas.</p>
  </div>
  <a class="button button-primary" href="/entregas/nova">+ Nova Entrega</a>
</section>

<section class="panel">
  <form class="filter-form" action="/entregas" method="GET">
    <label for="status">Filtrar por status</label>
    <select name="status" id="status">
      <option value="">Todos os status</option>
      <% for (const status of ['CRIADA', 'EM_TRANSITO', 'ENTREGUE', 'CANCELADA']) { %>
        <option value="<%= status %>" <%= statusSelecionado === status ? 'selected' : '' %>><%= status.replace('_', ' ') %></option>
      <% } %>
    </select>
    <button class="button button-secondary" type="submit">Filtrar</button>
    <% if (statusSelecionado) { %><a class="text-link" href="/entregas">Limpar</a><% } %>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Descrição</th><th>Origem</th><th>Destino</th><th>Status</th><th>Ação</th></tr>
      </thead>
      <tbody>
        <% if (entregas.length) { %>
          <% for (const entrega of entregas) { %>
            <tr>
              <td><strong><%= entrega.descricao %></strong></td>
              <td><%= entrega.origem %></td>
              <td><%= entrega.destino %></td>
              <td><span class="badge badge-<%= entrega.status.toLowerCase() %>"><%= entrega.status.replace('_', ' ') %></span></td>
              <td><a class="text-link" href="/entregas/<%= entrega.id %>">Ver detalhes →</a></td>
            </tr>
          <% } %>
        <% } else { %>
          <tr><td class="muted" colspan="5"><%= statusSelecionado ? 'Não há entregas com esse status.' : 'Nenhuma entrega cadastrada.' %></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
