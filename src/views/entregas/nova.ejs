<section class="page-heading">
  <div>
    <p class="eyebrow">Entregas</p>
    <h1>Nova entrega</h1>
    <p class="muted">Informe os dados para cadastrar uma entrega.</p>
  </div>
  <a class="button button-secondary" href="/entregas">Voltar</a>
</section>

<section class="panel form-panel">
  <% if (errors.length) { %>
    <div class="form-errors" role="alert">
      <p>Revise os dados informados:</p>
      <ul><% for (const error of errors) { %><li><%= error %></li><% } %></ul>
    </div>
  <% } %>
  <form action="/entregas" method="POST">
    <label for="descricao">Descrição</label>
    <input id="descricao" name="descricao" type="text" value="<%= entrega.descricao || '' %>" required>

    <div class="form-row">
      <div>
        <label for="origem">Origem</label>
        <input id="origem" name="origem" type="text" value="<%= entrega.origem || '' %>" required>
      </div>
      <div>
        <label for="destino">Destino</label>
        <input id="destino" name="destino" type="text" value="<%= entrega.destino || '' %>" required>
      </div>
    </div>

    <div class="form-actions">
      <button class="button button-primary" type="submit">Criar entrega</button>
      <a class="text-link" href="/entregas">Cancelar</a>
    </div>
  </form>
</section>
